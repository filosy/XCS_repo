#####Speed to Fly S2F _ VARIO MODE FORCE CLIMB
## is active only if page is not Auto mode

mode=default
type=key
data=S
event=SendNMEAPort2 g,s1
event=SendNMEAPort1 g,s1
event=StatusMessage SOLLFAHRT
event=UserDisplayModeForce forcecruise

mode=default
type=key
data=V
event=SendNMEAPort2 g,s0
event=SendNMEAPort1 g,s0
event=StatusMessage Vario
event=UserDisplayModeForce forceclimb

# Custom FLARM traffic zoom mapping
# UP = zoom in
# DOWN = zoom out

mode=default.Traffic Display1.Traffic Display2.Traffic
type=key
data=UP
event=Traffic zoom in

mode=default.Traffic Display1.Traffic Display2.Traffic
type=key
data=DOWN
event=Traffic zoom out
