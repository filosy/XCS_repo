# Test file based on GLB-XCI-xcremote-rpi4-7.44.xci
# Test purpose: verify whether F6 is received in the Traffic radar page.
# Changes from the original file:
# 1) The global F6 = Setup Alternates binding is disabled.
# 2) F6 in Traffic mode is assigned to Traffic next.
# 3) A StatusMessage is shown when the Traffic-mode F6 binding is triggered.
#
# If F6 still opens Alternates with this file, this XCI is not the file being
# loaded, or the active mode is not one of the Traffic modes listed below.

# Define gesture to open Quickmenu without keyboard or remote
mode=default
type=gesture
data=ULDR
event=QuickMenu

#mode=default
type=key
data=0
event=QuickMenu
label=QuickMenu
location=4

## XCRemote Reset StatusMessage
mode=default
type=key
data=e
event=StatusMessage XCREMOTE WILL RESET IN 2 SECONDS

mode=default
type=key
data=c
event=StatusMessage XCREMOTE Connected

### Edition21Buttons Sends PEV Start when X-Button is pressed long
mode=default
type=key
data=Q
event=PilotEvent
event=StatusMessage PILOT EVENT ANNOUNCED
event=PlaySound

##### Quickmenu buttons Vario and Back
mode=RemoteStick
type=key
data=0
event=Mode Vario_menu
event=StatusMessage Vario Menu
label=Vario
location=13

mode=RemoteStick
type=key
data=0
event=PilotEvent
event=StatusMessage PILOT EVENT ANNOUNCED
event=PlaySound
event=Mode default
label=Quit
location=33

mode=RemoteStick
type=key
data=0
event=Mode default
label=Zurück
location=31

###### Vario menu
mode=Vario_menu
type=key
data=RIGHT
event=SendNMEAPort2 g,v5
event=SendNMEAPort1 g,v5
