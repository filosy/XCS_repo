# F4 = FLARM radar entry; disabled in the original file as well
#mode=default
type=key
data=F4
event=FlarmTraffic
event=Mode default

# IMPORTANT TEST: disable the global F6 binding, which otherwise opens Alternates
#mode=default
type=key
data=F6
#event=Setup Alternates

##### Radar Page test for rpi4 / XCSoar 7.44
# F6 is deliberately used for Traffic next in this test.
mode=default.Traffic Display1.Traffic Display2.Traffic
type=key
data=F6
event=StatusMessage DEBUG F6 in Traffic
event=Traffic next

